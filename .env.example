# ============================================================
#  DG Travels — environment variables
#  Add these in Vercel: Project → Settings → Environment Variables
#  Copy to .env.local for local development (never commit that file).
# ============================================================

# --- Supabase (Project Settings → API) -----------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses Row Level
# Security, so it must stay server-side only — never put it in HTML.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email notifications (https://resend.com → API Keys) -----
RESEND_API_KEY=re_your_api_key

# Where new-feedback alerts are delivered (comma-separate for several)
NOTIFY_EMAIL_TO=b.rathnayaka77@gmail.com

# Sender address. The default below works immediately but only
# delivers to the address that owns the Resend account. Once you
# verify a domain in Resend, change it to e.g. "DG Travels <feedback@yourdomain.com>".
NOTIFY_EMAIL_FROM=DG Travels <onboarding@resend.dev>

# --- Google Maps (booking form) -----------------------------
# BROWSER key: powers the address autocomplete. It is served to the page
# and is therefore public — that is unavoidable for Maps in a browser.
# Lock it down in Google Cloud Console:
#   Application restrictions -> HTTP referrers -> your Vercel domain
#   API restrictions -> "Maps JavaScript API" + "Places API" only
GOOGLE_MAPS_BROWSER_KEY=

# SERVER key: used only by /api/distance, never sent to the browser.
# Restrict it to "Routes API" (and/or "Distance Matrix API").
# If you leave this empty the browser key is used as a fallback.
GOOGLE_MAPS_SERVER_KEY=
